# Pi5 独立 + L2 直连 Pi + MyView 在调度机
# cp .env.example .env && nano .env

# MyView 调度机 WebSocket 地址（Pi 能路由到的 LAN IP）
MYVIEW_SERVER_URL=ws://192.168.1.100:3000

# 与调度机 bridge-token 一致（/api/lidar/bridge-token），不要用浏览器 eyJ 登录 token。
MYVIEW_BRIDGE_TOKEN=

MYVIEW_DEVICE_ID=lidar-pi5-01

# L2 默认 IP；L2 认为 PC 在 192.168.1.2（Pi eth0 静态 IP）
LIDAR_IP=192.168.1.62
PC_IP=192.168.1.2
LIDAR_PORT=6101
PC_PORT=6201

WORK_MODE=0
USE_SYSTEM_TIMESTAMP=true
CLOUD_SCAN_NUM=18

RELAY_ODOM_TOPIC=/pointlio/odom
# 默认转发 Point-LIO 的【世界系】已配准点云 /pointlio/cloud_registered（由
# scan_publish_en: true 输出），与 /pointlio/odom 同一坐标系，点云、轨迹、设备三者
# 对齐、累积成图。若改回原始扫描 /unilidar/cloud，点云会缩在原点、轨迹飞出、二者对不上。
# 改前先 `rostopic list | grep cloud_registered` 确认实际 topic 名。
RELAY_CLOUD_TOPIC=/pointlio/cloud_registered
RELAY_IMU_TOPIC=/unilidar/imu
RELAY_MAX_QUEUED_FRAMES=4
RELAY_STATUS_INTERVAL_S=2.0

# ── 构建期（docker compose build）网络选项 ─────────────────────────────
# 仅在 `git clone` github 失败时才需要。compose 会把这些值注入构建参数。
# 现象：build 到 clone 步骤报 `server certificate verification failed.
#       CAfile: none` 或长时间卡住/超时 —— 多为网络无法访问 github 或 TLS 拦截。
# 1) 换成可达的 github 镜像（推荐，保留证书校验）：
# UNILIDAR_SDK2_REPO=https://kkgithub.com/unitreerobotics/unilidar_sdk2.git
# POINT_LIO_REPO=https://kkgithub.com/unitreerobotics/point_lio_unilidar.git
# 2) 仅在可信网络下临时关闭 TLS 校验（有中间人风险，不推荐长期使用）：
# GIT_SSL_NO_VERIFY=1

# ── Boot-order agnostic readiness ───────────────────────────────────
FIX_ROUTES=true
USE_POLICY_ROUTES=false
LIDAR_INTERFACE=eth0
LAN_INTERFACE=auto

BOOT_ROUTE_GUARD_S=120
BOOT_ROUTE_GUARD_INTERVAL_S=1

L2_WAIT_TIMEOUT_S=0
LAN_WAIT_TIMEOUT_S=30
MYVIEW_WAIT=true
MYVIEW_WAIT_TIMEOUT_S=120
TOPIC_WAIT_TIMEOUT_S=120
L2_UDP_WARMUP_S=5
L2_CONCURRENT_WARMUP_S=10
L2_ROUTE_RETRY_S=30
ETH0_SETTLE_S=2

IMU_SETTLE_S=8
RELAY_POSE_SETTLE_S=8
RELAY_IMU_GYRO_MAX_STD=0.08
RELAY_IMU_STABLE_SAMPLES=40

USE_POLICY_ROUTES=false
BOOT_ROUTE_GUARD_S=120
BOOT_ROUTE_GUARD_INTERVAL_S=1

LIO_RESTART_ON_READY=true
RELAY_START_EARLY=true
ROUTE_FIX_INTERVAL_S=5
L2_DOWN_THRESHOLD=3
L2_UP_THRESHOLD=2
L2_WATCHDOG_INTERVAL_S=5
