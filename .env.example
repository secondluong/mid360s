# NanoPC-T6 + Mid-360：板载网页为主（WiFi 局域网查看）
# cp .env.example .env && nano .env

# 板载查看页（主显示）。局域网打开 http://<T6的WiFi IP>:8080
LOCAL_VIEWER=true
LOCAL_VIEWER_PORT=8080
LOCAL_VIEWER_VOXEL=0.05
LOCAL_VIEWER_MAX_POINTS=400000

# MyView 推送：在板载网页 http://<T6的WiFi IP>:8080 点“设置”填写 IP 和端口。
# 网页保存后写到 data/settings/myview.json，以那里为准；下面几项只在第一次没保存过时作为默认值。
MYVIEW_RELAY=false
MYVIEW_SERVER_URL=wss://your-myview-host:3000
# 推送出口：wifi-first = 有 WiFi 且能连上 MyView 就走 WiFi，否则 4G 能上公网就走 4G。
# 旧模式 wan / lan / auto 仍可用。
MYVIEW_VIA=wifi-first

# 与调度机 /api/lidar/bridge-token 一致，不要用浏览器 eyJ 登录 token。
MYVIEW_BRIDGE_TOKEN=

MYVIEW_DEVICE_ID=lidar-t6-mid360-01

# 实时点云限流（网页“高级”里可改）：每秒最多几帧、每帧最多多少点。位姿不限流。
RELAY_CLOUD_HZ=5
RELAY_CLOUD_MAX_POINTS=8000

# Mid-360：出厂 IP = 192.168.1.1XX（XX = 机身序列号后两位）。
# 主机电口按 Livox 惯例设 192.168.1.50/24，不要默认网关。
# 官方 JSON 示例是 192.168.1.12，上板后务必改成你这台雷达的真实 IP。
# 换雷达后也可以直接在网页“设置”里改雷达 IP（存到 data/settings/lidar.json，优先于这里）。
LIDAR_IP=192.168.1.12
PC_IP=192.168.1.50
LIDAR_SUBNET=192.168.1.0/24

RELAY_ODOM_TOPIC=/pointlio/odom
# 世界系已配准点云，与 /pointlio/odom 同一坐标系。
RELAY_CLOUD_TOPIC=/pointlio/cloud_registered
RELAY_IMU_TOPIC=/livox/imu
DRIVER_CLOUD_TOPIC=/livox/lidar
RELAY_MAX_QUEUED_FRAMES=4
RELAY_STATUS_INTERVAL_S=2.0

# ── Offline catch-up ring (断网缓存续传) ───────────────────────────────
RELAY_OFFLINE_BUFFER=true
RELAY_OFFLINE_CLOUD=false
RELAY_OFFLINE_BUFFER_DIR=/var/lib/myview-relay/offline-buffer
RELAY_OFFLINE_BUFFER_MAX_BYTES=1610612736
RELAY_OFFLINE_CLOUD_HZ=1.0
RELAY_OFFLINE_CLOUD_MAX_POINTS=800
RELAY_OFFLINE_CATCHUP_BYTES_PER_SEC=2097152

# ── 构建期（docker compose build）网络选项 ─────────────────────────────
# LIVOX_SDK2_REPO=https://kkgithub.com/Livox-SDK/Livox-SDK2.git
# LIVOX_ROS_DRIVER2_REPO=https://kkgithub.com/Livox-SDK/livox_ros_driver2.git
# POINT_LIO_REPO=https://kkgithub.com/hku-mars/Point-LIO.git
# GIT_SSL_NO_VERIFY=1

# ── 三网口 ──────────────────────────────────────────────────────────
FIX_ROUTES=true
# 电口名上板后用 `ip -br link` 确认；T6 的 eth0/eth1 可能互换。
LIDAR_INTERFACE=eth0
# WiFi STA（加入现有路由）
LAN_INTERFACE=auto
# 4G（wwan0 / usb0 / ppp0 …）
WAN_INTERFACE=auto

BOOT_ROUTE_GUARD_S=120
BOOT_ROUTE_GUARD_INTERVAL_S=1

LIDAR_WAIT_TIMEOUT_S=0
LAN_WAIT_TIMEOUT_S=30
TOPIC_WAIT_TIMEOUT_S=120
LIDAR_UDP_WARMUP_S=5
LIDAR_CONCURRENT_WARMUP_S=10
LIDAR_ROUTE_RETRY_S=30
LINK_SETTLE_S=2

IMU_SETTLE_S=8
RELAY_POSE_SETTLE_S=8
RELAY_IMU_GYRO_MAX_STD=0.08
RELAY_IMU_STABLE_SAMPLES=40

LIO_RESTART_ON_READY=true
# true：开机就启动 MyView 推送程序，网页上马上能看到连接状态（位姿在 Point-LIO 稳定后才发）。
RELAY_START_EARLY=true
ROUTE_FIX_INTERVAL_S=5
LIDAR_DOWN_THRESHOLD=3
LIDAR_UP_THRESHOLD=2
LIDAR_WATCHDOG_INTERVAL_S=5
