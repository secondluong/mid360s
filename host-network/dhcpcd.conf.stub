# dhcpcd is not used on this host (NetworkManager owns eth0/wlan0).
# Kept minimal so accidental enable does not assign conflicting static IPs.
hostname
duid
persistent
vendorclassid
option domain_name_servers, domain_name, domain_search
option classless_static_routes
option interface_mtu
option host_name
option ntp_servers
require dhcp_server_identifier
slaac private
# eth0  -> 192.168.1.2/24  (NM: Wired connection 1)
# wlan0 -> 192.168.1.61/24 (NM: CU_LONGQR_5G)
