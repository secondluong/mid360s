[connection]
id=mesh61
type=wifi
interface-name=wlan0
autoconnect=true
autoconnect-priority=80
autoconnect-retries=0

[wifi]
mode=infrastructure
ssid=mesh61
powersave=2

[wifi-security]
key-mgmt=wpa-psk
psk=<SET_WIFI_PSK>

[ipv4]
method=manual
address1=192.168.1.61/24
never-default=true

[ipv6]
method=disabled

[proxy]
