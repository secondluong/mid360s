[connection]
id=wifi-sta
uuid=b2c3d4e5-f607-8910-bcde-f01234567890
type=wifi
autoconnect=true
autoconnect-priority=80
autoconnect-retries=0

[wifi]
mode=infrastructure
ssid=<SET_WIFI_SSID>

[wifi-security]
auth-alg=open
key-mgmt=wpa-psk
psk=<SET_WIFI_PSK>

[ipv4]
method=auto
never-default=true
route-metric=600

[ipv6]
method=auto

[proxy]
