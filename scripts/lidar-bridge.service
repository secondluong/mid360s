[Unit]
Description=MyView Lidar Bridge (T6 Mid-360, order-agnostic boot)
After=network-online.target docker.service
Requires=docker.service
Wants=network-online.target
# Ride out a slow boot, then stop retrying so a real fault stays visible.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=oneshot
RemainAfterExit=yes
# Change this path to wherever the repo lives on the T6.
WorkingDirectory=/opt/lidar-bridge-ros
EnvironmentFile=-/opt/lidar-bridge-ros/.env

# Routes are re-applied by the in-container watchdog, so a hiccup here must not
# keep the whole stack down.
ExecStartPre=-/opt/lidar-bridge-ros/scripts/fix-routes.sh
# No --force-recreate: docker-compose.yml pins container_name, so compose first
# removes the old container and then still tries to start that stale id, exits 1
# and leaves the unit failed with the stack half-up. Plain up is idempotent and
# keeps the container (and its logs) across reboots; it still recreates when
# docker-compose.yml or .env changed.
ExecStart=/usr/bin/docker compose up -d --remove-orphans
# stop, not down: next boot only has to start the existing container, and there
# is no container removal racing docker.service shutdown.
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=600
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
