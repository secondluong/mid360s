[Unit]
Description=MyView lidar route guard (early boot, before Docker)
After=network-online.target
Wants=network-online.target
Before=docker.service

[Service]
Type=simple
# Change this path to wherever the repo lives on the T6.
EnvironmentFile=-/opt/lidar-bridge-ros/.env
ExecStart=/opt/lidar-bridge-ros/scripts/fix-routes-boot-guard.sh
Restart=no

[Install]
WantedBy=multi-user.target
