[Unit]
Description=Disable wlan0 Wi-Fi power save (iw only; does not rewrite NM profiles)
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
# Prefer iw; fall back to iwconfig if needed.
ExecStart=/bin/sh -c '/sbin/iw dev wlan0 set power_save off 2>/dev/null || /sbin/iwconfig wlan0 power off 2>/dev/null || true'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
