#!/bin/sh
# NetworkManager dispatcher: re-disable Wi-Fi power save when wlan0 comes up.
# Install to /etc/NetworkManager/dispatcher.d/99-wifi-powersave-off (mode 755).
# Does NOT modify connection profiles or IPs.

IFACE="$1"
ACTION="$2"

[ "$IFACE" = "wlan0" ] || exit 0

case "$ACTION" in
  up|reapply|connectivity-change)
    /sbin/iw dev wlan0 set power_save off 2>/dev/null \
      || /sbin/iwconfig wlan0 power off 2>/dev/null \
      || true
    ;;
esac

exit 0
