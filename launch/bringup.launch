<launch>
  <!--
    Upstream Unitree ROS stack — algorithm nodes unchanged; launch params
    match point_lio_unilidar/launch/mapping_unilidar_l2.launch verbatim.

    The MyView relay is NOT included here (see entrypoint.sh).

    Pipeline:
      unitree_lidar_ros            → /unilidar/cloud  (PointCloud2)
                                    → /unilidar/imu    (Imu)
      point_lio_unilidar (LIO)     → /pointlio/odom   (nav_msgs/Odometry)
                                    → /pointlio/path
                                    → /pointlio/cloud_registered_body
  -->

  <!-- ── unitree_lidar_ros (driver) ──────────────────────────────── -->
  <node pkg="unitree_lidar_ros" type="unitree_lidar_ros_node"
        name="unitree_lidar_ros_node" respawn="true" output="screen">
    <rosparam command="load" file="$(find unitree_lidar_ros)/config/config.yaml"/>
  </node>

  <!-- ── point_lio_unilidar (LIO) ────────────────────────────────── -->
  <!-- Params below mirror mapping_unilidar_l2.launch (required for stable odom). -->
  <node pkg="point_lio_unilidar" type="pointlio_mapping"
        name="laserMapping" output="screen" respawn="true" respawn_delay="2">
    <rosparam command="load"
              file="$(find point_lio_unilidar)/config/unilidar_l2.yaml"/>

    <param name="use_imu_as_input" type="bool" value="0"/>
    <param name="prop_at_freq_of_imu" type="bool" value="1"/>
    <param name="check_satu" type="bool" value="1"/>
    <param name="init_map_size" type="int" value="10"/>
    <param name="point_filter_num" type="int" value="1"/>
    <param name="space_down_sample" type="bool" value="1"/>
    <param name="filter_size_surf" type="double" value="0.4"/>
    <param name="filter_size_map" type="double" value="0.4"/>
    <param name="cube_side_length" type="double" value="1000"/>
    <param name="runtime_pos_log_enable" type="bool" value="0"/>
  </node>
</launch>
